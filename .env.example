# Salin file ini menjadi .env lalu isi dengan kredensial Firebase Anda.
# Dapatkan dari: Firebase Console > Project settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# URL Web App Google Apps Script (Deploy > Web app > Anyone) untuk kirim & verifikasi OTP
VITE_OTP_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# 3 email Admin KPU (pisahkan dengan koma). Harus sama dengan akun di Firebase Auth
# dan dengan daftar email di firestore.rules.
VITE_ADMIN_EMAILS=admin1@kpu.ac.id,admin2@kpu.ac.id,admin3@kpu.ac.id
