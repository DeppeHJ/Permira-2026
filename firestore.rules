rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Fungsi bantu
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Pemilih = pengguna Anonymous Auth.
    function isVoter() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Admin Panitia = login Email/Password dengan salah satu dari 3 email resmi.
    // WAJIB sama dengan VITE_ADMIN_EMAILS dan akun yang dibuat di Firebase Auth.
    function isKpuAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.lower() in [
          'admin1@kpu.ac.id',
          'admin2@kpu.ac.id',
          'admin3@kpu.ac.id'
        ];
    }

    // Super Admin = login Email/Password dengan email di bawah ini.
    // WAJIB sama dengan VITE_SUPER_ADMIN_EMAILS dan akun yang dibuat di Firebase Auth.
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.lower() in [
          'superadmin@kpu.ac.id'
        ];
    }

    // Super Admin otomatis memiliki seluruh hak Admin Panitia.
    function isAdmin() {
      return isKpuAdmin() || isSuperAdmin();
    }

    // ID kandidat: menerima kandidat bawaan (ai-01..ai-03, bem-01..bem-02)
    // ATAU kandidat dinamis yang dibuat Super Admin di koleksi `candidates`.
    function candidateOfType(id, type) {
      return exists(/databases/$(database)/documents/candidates/$(id))
        && get(/databases/$(database)/documents/candidates/$(id)).data.type == type;
    }
    function validAiId(id) {
      return id in ['ai-01', 'ai-02', 'ai-03']
        || candidateOfType(id, 'ai');
    }
    function validKabemId(id) {
      return id in ['bem-01', 'bem-02']
        || candidateOfType(id, 'kabem');
    }

    // ------------------------------------------------------------------
    // dpt/{npm} — identitas pemilih (TERPISAH dari kotak suara)
    // Field: npm, nama, email, angkatan, hasVoted, votedAt
    // ------------------------------------------------------------------
    match /dpt/{npm} {
      // Pemilih hanya boleh membaca SATU dokumen berdasarkan NPM (tidak bisa list/scan).
      allow get: if isAdmin() || isVoter();
      allow list: if isAdmin();

      // Admin menambah pemilih baru (impor CSV) dengan hasVoted = false.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['npm', 'nama', 'email', 'angkatan', 'hasVoted', 'votedAt'])
        && request.resource.data.npm == npm
        && (request.resource.data.hasVoted == false || request.resource.data.hasVoted == null)
        && request.resource.data.votedAt == null;

      allow update: if
        // Admin boleh memperbarui data, tetapi TIDAK boleh membalik status memilih.
        (isAdmin()
          && request.resource.data.hasVoted == resource.data.hasVoted
          && request.resource.data.votedAt == resource.data.votedAt)
        ||
        // Pemilih: satu arah false/null/'false' -> true, hanya field hasVoted & votedAt, waktu dari server.
        (isVoter()
          && (resource.data.hasVoted == false || resource.data.hasVoted == null || resource.data.hasVoted == 'false')
          && request.resource.data.hasVoted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasVoted', 'votedAt'])
          && request.resource.data.votedAt == request.time);

      // Admin Panitia hanya boleh menghapus pemilih yang belum memilih.
      // Super Admin boleh menghapus semuanya (reset DPT untuk periode baru).
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.hasVoted == false);
    }

    // ------------------------------------------------------------------
    // votes/{id} — kotak suara ANONIM (tanpa NPM/email/nama/waktu)
    // ------------------------------------------------------------------
    match /votes/{ballotId} {
      allow read: if isAdmin();

      allow create: if isVoter()
        && request.resource.data.keys().hasOnly(['aiId', 'kabemId'])
        && request.resource.data.keys().hasAll(['aiId', 'kabemId'])
        && request.resource.data.aiId is string
        && request.resource.data.kabemId is string
        && validAiId(request.resource.data.aiId)
        && validKabemId(request.resource.data.kabemId);

      // Surat suara tidak dapat diubah. Hanya Super Admin yang boleh mengosongkan
      // kotak suara (reset untuk periode baru).
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------
    // stats/{angkatan} — statistik publik partisipasi per angkatan
    // Field: label, order, total, voted
    // ------------------------------------------------------------------
    match /stats/{angkatan} {
      allow read: if isAdmin() || isVoter();
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        ||
        // Pemilih hanya boleh menambah `voted` sebanyak tepat 1 (dalam transaksi pemungutan suara).
        (isVoter()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voted'])
          && request.resource.data.voted == (('voted' in resource.data && resource.data.voted != null) ? resource.data.voted + 1 : 1));
    }

    // ------------------------------------------------------------------
    // config/{docId} — pengaturan pemilihan: election, timeline, sop
    // Dibaca publik (halaman login memerlukan nama/tahun), ditulis Super Admin.
    // ------------------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ------------------------------------------------------------------
    // candidates/{id} — data kandidat AI & paslon Kabem
    // ------------------------------------------------------------------
    match /candidates/{candidateId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Semua koleksi lain ditolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
